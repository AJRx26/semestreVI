<%- include('partials/header') %>

<section class="container py-5" id="contacto">

    <header class="text-center mb-5">
        <h1>Contacto</h1>
        <p class="lead">
            Ponte en contacto con nuestro equipo para recibir asesoría
            y soluciones tecnológicas personalizadas.
        </p>
    </header>

    <!-- Información de contacto -->
    <section class="mb-5">
        <div class="row g-4">
            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Teléfono</h5>
                        <p class="card-text">+52 999 999 9999</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Correo electrónico</h5>
                        <p class="card-text">contacto@seguritech.com</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Ubicación</h5>
                        <p class="card-text">Veracruz, México</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Horario</h5>
                        <p class="card-text">
                            Lunes - Viernes<br>
                            9:00 AM - 6:00 PM
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Formulario de solicitud -->
    <section>
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h4 mb-0 fw-bold">Solicitar Cotización</h2>
                    </div>

                    <div class="card-body">

                        <!-- Mensaje de éxito -->
                        <% if (typeof exito !== 'undefined' && exito) { %>
                        <div class="alert alert-success" role="alert">
                            Solicitud enviada correctamente. Nos pondremos en contacto pronto.
                        </div>
                        <% } %>

                        <!-- Errores de validación -->
                        <% if (typeof errores !== 'undefined' && errores.length > 0) { %>
                        <div class="alert alert-danger" role="alert">
                            <ul class="mb-0 ps-3">
                                <% errores.forEach(err => { %>
                                <li><%= err %></li>
                                <% }); %>
                            </ul>
                        </div>
                        <% } %>

                        <form id="solicitudForm" action="/solicitud" method="POST" enctype="multipart/form-data" novalidate>

                            <!-- Nombre -->
                            <div class="mb-3">
                                <label for="nombre" class="form-label fw-bold">Nombre completo *</label>
                                <input
                                    type="text"
                                    class="form-control <%= typeof errores !== 'undefined' && errores.some(e => e.toLowerCase().includes('nombre')) ? 'is-invalid' : '' %>"
                                    name="nombre"
                                    id="nombre"
                                    value="<%= typeof formData !== 'undefined' ? formData.nombre : '' %>"
                                    required
                                    minlength="3"
                                    maxlength="150"
                                    autocomplete="name"
                                >
                                <div class="invalid-feedback">Mínimo 3 caracteres.</div>
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label for="email" class="form-label fw-bold">Email *</label>
                                <input
                                    type="email"
                                    class="form-control <%= typeof errores !== 'undefined' && errores.some(e => e.toLowerCase().includes('email')) ? 'is-invalid' : '' %>"
                                    name="email"
                                    id="email"
                                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                                    required
                                    maxlength="150"
                                    autocomplete="email"
                                >
                                <div class="invalid-feedback">Email inválido.</div>
                            </div>

                            <!-- Teléfono -->
                            <div class="mb-3">
                                <label for="telefono" class="form-label fw-bold">Teléfono *</label>
                                <input
                                    type="tel"
                                    class="form-control <%= typeof errores !== 'undefined' && errores.some(e => e.toLowerCase().includes('tel')) ? 'is-invalid' : '' %>"
                                    name="telefono"
                                    id="telefono"
                                    value="<%= typeof formData !== 'undefined' ? formData.telefono : '' %>"
                                    required
                                    minlength="7"
                                    maxlength="20"
                                    autocomplete="tel"
                                >
                                <div class="invalid-feedback">Mínimo 7 dígitos.</div>
                            </div>

                            <!-- Servicio -->
                            <div class="mb-3">
                                <label for="servicio_id" class="form-label fw-bold">Servicio *</label>
                                <select
                                    class="form-select <%= typeof errores !== 'undefined' && errores.some(e => e.toLowerCase().includes('servicio')) ? 'is-invalid' : '' %>"
                                    name="servicio_id"
                                    id="servicio_id"
                                    required
                                >
                                    <option value="" disabled <%= typeof formData === 'undefined' ? 'selected' : '' %>>
                                        Selecciona un servicio
                                    </option>
                                    <% servicios.forEach(s => { %>
                                    <option
                                        value="<%= s.id %>"
                                        <%= typeof formData !== 'undefined' && parseInt(formData.servicio_id) === s.id ? 'selected' : '' %>
                                    >
                                        [<%= s.categoria_nombre || 'General' %>] <%= s.nombre %>
                                    </option>
                                    <% }); %>
                                </select>
                                <div class="invalid-feedback">Selecciona un servicio.</div>
                            </div>

                            <!-- Archivo -->
                            <div class="mb-3">
                                <label for="archivo" class="form-label fw-bold">Archivo adjunto</label>
                                <input
                                    type="file"
                                    class="form-control"
                                    name="archivo"
                                    id="archivo"
                                    accept=".jpg,.jpeg,.png,.pdf,.doc,.docx"
                                >
                                <div class="form-text">Formatos permitidos: JPG, PNG, PDF, DOC, DOCX. Máximo 5 MB.</div>
                            </div>

                            <!-- Mensaje -->
                            <div class="mb-3">
                                <label for="mensaje" class="form-label fw-bold">Mensaje *</label>
                                <textarea
                                    class="form-control <%= typeof errores !== 'undefined' && errores.some(e => e.toLowerCase().includes('mensaje')) ? 'is-invalid' : '' %>"
                                    name="mensaje"
                                    id="mensaje"
                                    rows="4"
                                    required
                                    minlength="10"
                                    maxlength="2000"
                                ><%= typeof formData !== 'undefined' ? formData.mensaje : '' %></textarea>
                                <div class="invalid-feedback">Mínimo 10 caracteres.</div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

</section>

<%- include('partials/footer') %>

<script>
document.getElementById('solicitudForm').addEventListener('submit', function (e) {
    var valido = true;

    var nombre = document.getElementById('nombre');
    if (nombre.value.trim().length < 3) {
        nombre.classList.add('is-invalid');
        valido = false;
    } else {
        nombre.classList.remove('is-invalid');
    }

    var email = document.getElementById('email');
    var reEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!reEmail.test(email.value.trim())) {
        email.classList.add('is-invalid');
        valido = false;
    } else {
        email.classList.remove('is-invalid');
    }

    var telefono = document.getElementById('telefono');
    if (telefono.value.trim().length < 7) {
        telefono.classList.add('is-invalid');
        valido = false;
    } else {
        telefono.classList.remove('is-invalid');
    }

    var servicio = document.getElementById('servicio_id');
    if (!servicio.value) {
        servicio.classList.add('is-invalid');
        valido = false;
    } else {
        servicio.classList.remove('is-invalid');
    }

    var mensaje = document.getElementById('mensaje');
    if (mensaje.value.trim().length < 10) {
        mensaje.classList.add('is-invalid');
        valido = false;
    } else {
        mensaje.classList.remove('is-invalid');
    }

    if (!valido) e.preventDefault();
});
</script>
