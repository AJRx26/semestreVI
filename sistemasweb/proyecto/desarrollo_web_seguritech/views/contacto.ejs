<%- include('partials/header') %>

<section class="container py-5" id="contacto">

    <header class="text-center mb-5">
        <h1>Contacto</h1>
        <p class="lead">
            Ponte en contacto con nuestro equipo para recibir asesoría
            y soluciones tecnológicas personalizadas.
        </p>
    </header>

    <!-- Información de contacto -->
    <section class="mb-5">
        <div class="row g-4">
            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Teléfono</h5>
                        <p class="card-text">+52 999 999 9999</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Correo electrónico</h5>
                        <p class="card-text">contacto@seguritech.com</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Ubicación</h5>
                        <p class="card-text">Veracruz, México</p>
                    </div>
                </article>
            </div>

            <div class="col-md-3">
                <article class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h5 class="card-title">Horario</h5>
                        <p class="card-text">
                            Lunes - Viernes<br>
                            9:00 AM - 6:00 PM
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Formulario de solicitud -->
    <section>
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h4 mb-0 fw-bold">Solicitar Cotización</h2>
                    </div>

                    <div class="card-body">
                        <form id="solicitudForm" action="/solicitud" method="POST" enctype="multipart/form-data" novalidate>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre completo *</label>

                                <input type="text" class="form-control" name="nombre" id="nombre" value="<%= typeof formData !== 'undefined' ? formData.nombre : '' %>" required minlength="3">
                                <div class="invalid-feedback">Mínimo 3 caracteres.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Email *</label>

                                <input type="email" class="form-control" name="email" id="email" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
                                <div class="invalid-feedback">Email inválido.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Teléfono *</label>

                                <input type="tel" class="form-control" name="telefono" id="telefono" required minlength="7">
                                <div class="invalid-feedback">Mínimo 7 caracteres.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Servicio *</label>

                                <select class="form-select" name="servicio_id" id="servicio_id" required>

                                    <option value="" disabled selected>Selecciona un servicio</option>
                                    <% servicios.forEach(s => { %>
                                    <option value="<%= s.id %>">
                                        <%= s.nombre %>
                                    </option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Archivo adjunto</label>

                                <input type="file" class="form-control" name="archivo">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Mensaje *</label>
                                <textarea class="form-control" name="mensaje" id="mensaje" rows="4" required minlength="10"></textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>

<%- include('partials/footer') %>