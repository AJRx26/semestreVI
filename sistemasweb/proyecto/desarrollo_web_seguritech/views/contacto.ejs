<%- include('partials/header') %>

<section class="container py-5">

    <h1 class="text-center mb-5">Solicitar Cotización</h1>

    <div class="container py-5" id="contacto">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0 fw-bold">Solicitar Cotización</h4>
                    </div>
                    <div class="card-body">
                        <form id="solicitudForm" action="/solicitud" method="POST" enctype="multipart/form-data" novalidate>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre completo *</label>
                                <input type="text" class="form-control" name="nombre" id="nombre" value="<%= typeof formData !== 'undefined' ? formData.nombre : '' %>" required minlength="3">
                                <div class="invalid-feedback">Mínimo 3 caracteres.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email *</label>
                                <input type="email" class="form-control" name="email" id="email" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
                                <div class="invalid-feedback">Email inválido.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Teléfono *</label>
                                <input type="tel" class="form-control" name="telefono" id="telefono" value="<%= typeof formData !== 'undefined' ? formData.telefono : '' %>" required minlength="7">
                                <div class="invalid-feedback">Mínimo 7 caracteres.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Servicio *</label>
                                <select class="form-select" name="servicio_id" id="servicio_id" required>
                                    <option value="" disabled selected>Selecciona un servicio</option>
                                    <% servicios.forEach(s => { %>
                                        <option value="<%= s.id %>" <%= typeof formData !== 'undefined' && formData.servicio_id == s.id ? 'selected' : '' %>><%= s.nombre %></option>
                                    <% }); %>
                                </select>
                                <div class="invalid-feedback">Selecciona un servicio.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Archivo adjunto (opcional)</label>
                                <input type="file" class="form-control" name="archivo" id="archivo" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx">
                                <div class="form-text">JPG, PNG, PDF, DOC, DOCX. Máx 5MB.</div>
                                <div id="fileError" class="text-danger small d-none"></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Mensaje *</label>
                                <textarea class="form-control" name="mensaje" id="mensaje" rows="3" required minlength="10"><%= typeof formData !== 'undefined' ? formData.mensaje : '' %></textarea>
                                <div class="invalid-feedback">Mínimo 10 caracteres.</div>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary" id="btnSubmit">Enviar Solicitud</button>
                            </div>
                            <div id="loadingSpinner" class="text-center mt-2 d-none">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                                <span class="small text-muted">Enviando...</span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>

<%- include('partials/footer') %>