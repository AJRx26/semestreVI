<%- include('partials/header') %>

<div class="container py-4 mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Dashboard</h2>
    <a href="/" class="btn btn-outline-dark btn-sm">Volver</a>
  </div>

  <div id="loadingDashboard" class="text-center py-5">
    <div class="spinner-border text-primary"></div>
    <p class="text-muted mt-2">Cargando datos...</p>
  </div>

  <div id="dashboardContent" class="d-none">
    <!-- KPIs -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <h3 class="text-primary fw-bold mb-1" id="kpiTotalSolicitudes">0</h3>
            <small class="text-muted">Total Solicitudes</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <h3 class="text-success fw-bold mb-1" id="kpiTotalServicios">0</h3>
            <small class="text-muted">Servicios</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <h6 class="text-warning fw-bold mb-1 text-truncate" id="kpiServicioTop">-</h6>
            <small class="text-muted">Más Solicitado</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <h3 class="text-info fw-bold mb-1" id="kpiPendientes">0</h3>
            <small class="text-muted">Pendientes</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Gráficos -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header fw-bold">Solicitudes por Estado</div>
          <div class="card-body" id="estadosContainer"></div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header fw-bold">Solicitudes por Servicio</div>
          <div class="card-body" id="serviciosContainer"></div>
        </div>
      </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm">
      <div class="card-header fw-bold">Últimas 5 Solicitudes</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
              <tr><th>ID</th><th>Cliente</th><th>Servicio</th><th>Estado</th><th>Fecha</th></tr>
            </thead>
            <tbody id="tbodySolicitudes"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div id="dashboardError" class="d-none">
    <div class="alert alert-danger text-center">
      <p class="mb-2">Error al cargar el dashboard.</p>
      <button class="btn btn-danger btn-sm" id="btnReintentar">Reintentar</button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
